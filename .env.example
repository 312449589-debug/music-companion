# Copy to .env in the project root; never commit .env.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BUDGET_CNY=200
# qwen-plus, non-thinking, Beijing <=128k: verify against the current official price.
QWEN_INPUT_PRICE_PER_MILLION_CNY=0.8
QWEN_OUTPUT_PRICE_PER_MILLION_CNY=2
# Paths are relative to the project root. These local files are ignored by Git.
FLUIDSYNTH_PATH=.tools/audio/bin/fluidsynth
FFMPEG_PATH=.tools/audio/bin/ffmpeg
SOUNDFONT_PATH=.tools/soundfonts/FluidR3Mono_GM.sf3
PLAYWRIGHT_BROWSERS_PATH=.tools/browsers
